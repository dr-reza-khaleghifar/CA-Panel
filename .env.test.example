# Copy to .env.test and chmod 600. Never commit the resulting .env.test.
# Use the UID/GID that own the .testbed directory on the host.
APP_UID=1000
APP_GID=1000

# Must exactly match the encrypted TEST Issuing CA passphrase.
# Keep this value private. Single quotes preserve literal $ characters.
CA_KEY_PASSWORD='REPLACE_WITH_TEST_ISSUER_PASSPHRASE'

# Test-only hostnames and loopback ports.
PANEL_DOMAIN=ca-panel-test.iravand.ir
TEST_API_PORT=18080
TEST_HTTPS_PORT=18443

# All persistent test data and secrets are separate from the live deployment.
DATA_HOST_DIR=./.testbed/data
CA_ONLINE_HOST_DIR=./.testbed/pki/online
PANEL_TLS_HOST_DIR=./.testbed/secrets/tls

# Test CA identity. These values are used only when creating a NEW test CA.
CA_ROOT_CN='CA-Panel Test Root CA'
CA_ISSUER_CN='CA-Panel Test Issuing CA'
CA_ROOT_ORGANIZATION='Pardis AI Innovation Test Lab'
CA_ISSUER_ORGANIZATION='Pardis AI Innovation Test Lab'
CA_ROOT_VALIDITY_DAYS=3650
CA_ISSUER_VALIDITY_DAYS=365
CA_ROOT_KEY_BITS=3072
CA_ISSUER_KEY_BITS=3072
CA_ROOT_KEY_FILE=root-key.pem
CA_ROOT_CERT_FILE=root-cert.pem
CA_ISSUER_KEY_FILE=issuer-key.pem
CA_ISSUER_CERT_FILE=issuer-cert.pem

# Display/policy settings for the test application.
CA_DISPLAY_NAME='CA Panel Test'
CA_ORGANIZATION='Pardis AI Innovation Test Lab'
CERT_VALIDITY_DAYS=30
SERVER_KEY_BITS=2048
CHALLENGE_SECONDS=3600
MAX_REQUESTS_PER_HOUR=20
MAX_TOTAL_PER_HOUR=200
MAX_VERIFICATIONS=10
DOWNLOAD_TTL_SECONDS=600
MAX_PENDING_DOWNLOADS=100

# Admin enrollment is performed separately with:
# python3 scripts/setup_admin.py --env .env.test
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_GENERATION=

# Keep issuance restricted. The admin enrollment step will ask for an explicit
# domain suffix allowlist. DNS TXT ownership validation remains mandatory.
CERT_ALLOWED_DOMAINS=
CERT_ALLOW_ANY_DOMAIN=0
TRUST_PROXY_HEADERS=0
DNS_RESOLVERS=
