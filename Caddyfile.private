{
    # Private CA TLS is supplied from files; no ACME attempts and no HTTP:80 redirect.
    auto_https disable_redirects
}

https://{$PANEL_DOMAIN} {
    tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem
    encode zstd gzip
    reverse_proxy api:8000
}

# A SINGLE static trust-help page on HTTP (no certificate, CSS, API or download).
# HTTP is NEVER a fallback for the login, issuance API, MFA or private ZIPs.
# Browsers cannot automatically navigate here after a TLS certificate error.
http://{$PANEL_DOMAIN} {
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }

    @guide_only {
        method GET HEAD
        path /
    }
    handle @guide_only {
        root * /srv/onboarding
        file_server
    }
    handle {
        respond "Not found. CA login and issuance require HTTPS." 404
    }
}
