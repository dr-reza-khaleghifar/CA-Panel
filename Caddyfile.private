{
    # Publicly trusted HTTPS for the portal; redirects stay disabled so the HTTP trust guide remains reachable.
    auto_https disable_redirects
}

https://{$PANEL_DOMAIN} {
    encode zstd gzip

    # Only the two public Root CA encodings are served from this static directory.
    @root_download {
        method GET HEAD
        path /downloads/ca-panel-root-ca.pem /downloads/ca-panel-root-ca.cer
    }
    handle @root_download {
        uri strip_prefix /downloads
        root * /srv/onboarding
        header {
            Content-Disposition "attachment"
            X-Content-Type-Options "nosniff"
            Cache-Control "no-store"
        }
        file_server
    }

    handle {
        reverse_proxy api:8000 {
            # Caddy overwrites this header with the actual peer IP for API rate limiting.
            header_up X-Real-IP {remote_host}
        }
    }
}

# HTTP is restricted to the static trust guide, its local helper script and public Root CA files.
# No login, API, MFA, issuance endpoints, or private downloads are exposed on HTTP.
http://{$PANEL_DOMAIN} {
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }

    @root_download {
        method GET HEAD
        path /downloads/ca-panel-root-ca.pem /downloads/ca-panel-root-ca.cer
    }
    handle @root_download {
        uri strip_prefix /downloads
        root * /srv/onboarding
        header {
            Content-Disposition "attachment"
            X-Content-Type-Options "nosniff"
        }
        file_server
    }

    @guide_assets {
        method GET HEAD
        path /trust.js
    }
    handle @guide_assets {
        root * /srv/onboarding
        file_server
    }

    @guide_only {
        method GET HEAD
        path /
    }
    handle @guide_only {
        root * /srv/onboarding
        file_server
    }

    handle {
        respond "Not found. CA login and issuance require HTTPS." 404
    }
}
