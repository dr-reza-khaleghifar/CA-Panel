# Copy to .env. Match Linux host ownership: id -u / id -g.
APP_UID=1000
APP_GID=1000
# Exact passphrase chosen for the online issuing CA during scripts/init_ca.py
CA_KEY_PASSWORD=REPLACE_WITH_ISSUING_CA_PASSPHRASE
# Optional. For Docker DNS NXDOMAIN when public authoritative TXT exists:
# DNS_RESOLVERS=1.1.1.1,1.0.0.1
# Blank (default) uses Docker/container system DNS. DNS queries go to selected resolver(s).
DNS_RESOLVERS=
# Public hostname for the portal's Caddy/ACME certificate. It must resolve to this server.
PANEL_DOMAIN=ca1.iravand.ir
# Public portal HTTPS (ACME) binds to this address; public deployment normally uses 0.0.0.0.
PANEL_TLS_BIND_IP=0.0.0.0
# HTTP:80 serves only the Root CA trust guide/downloads and ACME HTTP-01 challenges.
PANEL_HTTP_BIND_IP=0.0.0.0
# Production Compose trusts X-Real-IP only because the API is loopback-only and Caddy overwrites it.

# SECURITY: Run python3 scripts/setup_admin.py before exposing the panel.
# Existing installations are fail-closed until the admin is enrolled.
# These values are generated locally; never upload or share .env.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_GENERATION=
# Exact domain or subdomain suffixes, e.g. iravand.ir,example.org.
# Blank denies issuance unless explicit CERT_ALLOW_ANY_DOMAIN=1 below.
CERT_ALLOWED_DOMAINS=
# Opt-in ONLY: allow public users to submit requests for ANY valid public DNS hostname.
# Every request still requires DNS TXT proof and administrator approval before signing.
# Overrides the allowed-domain list when set to 1. Default is 0 (restricted).
CERT_ALLOW_ANY_DOMAIN=0

# ---- Public CA panel information (displayed by GET /api/system) ----
CA_DISPLAY_NAME='گواهی دیجیتال ایران'
CA_ORGANIZATION='Iran CA Center'

# ---- X.509 Root/Issuing CA CREATION profile (ONLY for a new CA) ----
# These values are used by "bash install.sh --init-ca" or
# "python scripts/init_ca.py --env .env" on a trusted OFFLINE workstation.
# Editing them later does NOT change existing signed CA certificates.
# Common Names (CN) are limited to 64 UTF-8 bytes.
CA_ROOT_CN=CA-Panel Offline Root CA
CA_ISSUER_CN=CA-Panel Online Issuing CA
# Optional O fields on the actual CA certificates; empty means omit.
CA_ROOT_ORGANIZATION=
CA_ISSUER_ORGANIZATION=
# Days: Root 365-7300; Issuer 30-3650 and 7+ days shorter than Root.
CA_ROOT_VALIDITY_DAYS=3650
CA_ISSUER_VALIDITY_DAYS=365
# CA signing RSA keys: 3072 or 4096 bits. Separate from SERVER_KEY_BITS.
CA_ROOT_KEY_BITS=3072
CA_ISSUER_KEY_BITS=3072
# Offline encrypted Root key filename. NEVER mount/copy it into Docker.
CA_ROOT_KEY_FILE=root-key.pem

# ---- Existing Issuing CA PEM files: host directory mounted READ-ONLY ----
CA_ONLINE_HOST_DIR=./secrets/online
CA_DIR=/run/ca
# These filenames are honored BOTH by new-CA generation and by runtime
# when locating the existing PEMs in CA_DIR.
CA_ISSUER_KEY_FILE=issuer-key.pem
CA_ISSUER_CERT_FILE=issuer-cert.pem
CA_ROOT_CERT_FILE=root-cert.pem

# ---- SQLite database location ----
DATA_HOST_DIR=./data
DB_PATH=/data/ca-panel.sqlite3

# ---- Certificate issuance and DNS policy ----
CERT_VALIDITY_DAYS=30
SERVER_KEY_BITS=2048
CHALLENGE_SECONDS=3600
MAX_REQUESTS_PER_HOUR=20
MAX_TOTAL_PER_HOUR=200
MAX_VERIFICATIONS=10

# ---- Private ZIP capability (max 10 minutes; key stays only in RAM) ----
DOWNLOAD_TTL_SECONDS=600
MAX_PENDING_DOWNLOADS=100

# Runtime displays Root/Issuer Common Names read from the actual PEMs.
# Changing CA_ROOT_CN / CA_ISSUER_CN on an existing CA has NO effect and
# must not be used as a substitute for an explicit CA-rotation procedure.
# Restart/recreate the API container for .env changes to take effect.
