# Copy to .env. Match Linux host ownership: id -u / id -g.
APP_UID=1000
APP_GID=1000
# Exact passphrase chosen for the online issuing CA during scripts/init_ca.py
CA_KEY_PASSWORD=REPLACE_WITH_ISSUING_CA_PASSPHRASE
# Only enable behind trusted reverse proxy. Do NOT expose API to untrusted proxies.
TRUST_PROXY_HEADERS=0
# Optional. For Docker DNS NXDOMAIN when public authoritative TXT exists:
# DNS_RESOLVERS=1.1.1.1,1.0.0.1
# Blank (default) uses Docker/container system DNS. DNS queries go to selected resolver(s).
DNS_RESOLVERS=
# Optional: public HTTPS endpoint for the panel (Caddy --profile public)
PANEL_DOMAIN=ca.example.org
